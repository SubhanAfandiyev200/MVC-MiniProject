@model CourseInfoDetailVM
<div class="container mt-5">
    <h2 class="text-center mb-4">Course Info Details</h2>
    
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">@Model.Title</h4>
            <hr />
            
            <div class="row mb-3">
                <div class="col-md-3"><strong>Description:</strong></div>
                <div class="col-md-9">@Model.Description</div>
            </div>

            <div class="row mb-3">
                <div class="col-md-3"><strong>Price:</strong></div>
                <div class="col-md-9">$@Model.Price</div>
            </div>

            <div class="row mb-3">
                <div class="col-md-3"><strong>Sales Count:</strong></div>
                <div class="col-md-9">@Model.SalesCount</div>
            </div>

            <div class="row mb-3">
                <div class="col-md-3"><strong>Teacher:</strong></div>
                <div class="col-md-9">@Model.Teacher (ID: @Model.TeacherId)</div>
            </div>

            <div class="row mb-3">
                <div class="col-md-3"><strong>Is Featured:</strong></div>
                <div class="col-md-9">
                    @if (Model.IsFeature)
                    {
                        <span class="badge bg-success">Yes</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">No</span>
                    }
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-3"><strong>Is New:</strong></div>
                <div class="col-md-9">
                    @if (Model.IsNew)
                    {
                        <span class="badge bg-info">Yes</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">No</span>
                    }
                </div>
            </div>

            <hr />
            <h5 class="mt-4 mb-3">Course Images (@Model.Images.Count)</h5>
            
            <div class="row">
                @foreach (var image in Model.Images)
                {
                    <div class="col-md-3 mb-4" id="image-@image.Id">
                        <div class="card">
                            <img src="~/images/@image.Name" class="card-img-top" alt="Course Image" style="height: 200px; object-fit: cover;">
                            <div class="card-body text-center">
                                @if (image.IsMain)
                                {
                                    <span class="badge bg-success mb-2">Main Image</span>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-primary set-main-image mb-2" 
                                            data-course-id="@Model.Id" 
                                            data-image-id="@image.Id">
                                        Set as Main
                                    </button>
                                }
                                <br />
                                @if (!image.IsMain)
                                {
                                    <button class="btn btn-sm btn-danger delete-image" 
                                            data-image-id="@image.Id">
                                        Delete
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="mt-4">
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Set Main Image
            $('.set-main-image').click(function () {
                var courseId = $(this).data('course-id');
                var imageId = $(this).data('image-id');
                var button = $(this);

                $.ajax({
                    url: '/Admin/CourseInfo/UpdateMainImage',
                    type: 'POST',
                    data: { courseInfoId: courseId, imageId: imageId },
                    success: function (result) {
                        if (result.success) {
                            location.reload();
                        }
                    },
                    error: function () {
                        alert('An error occurred while updating the main image.');
                    }
                });
            });

            // Delete Image
            $('.delete-image').click(function () {
                var imageId = $(this).data('image-id');
                var imageCard = $('#image-' + imageId);

                if (confirm('Are you sure you want to delete this image?')) {
                    $.ajax({
                        url: '/Admin/CourseInfo/DeleteImage',
                        type: 'POST',
                        data: { imageId: imageId },
                        success: function (result) {
                            if (result.success) {
                                imageCard.fadeOut(300, function () {
                                    $(this).remove();
                                });
                            }
                        },
                        error: function (xhr) {
                            var response = xhr.responseJSON;
                            if (response && response.message) {
                                alert(response.message);
                            } else {
                                alert('An error occurred while deleting the image.');
                            }
                        }
                    });
                }
            });
        });
    </script>
}
