@model SliderEditVM

<div class="container mt-5">
    <form class="forms-sample" method="post" asp-action="Edit" enctype="multipart/form-data">
        <div class="form-group">
            <label>Sliders</label>

            @if (!string.IsNullOrEmpty(Model.ExistingLogo))
            {
                <div class="mb-2">
                    <img src="~/images/@Model.ExistingLogo" width="150" />
                </div>
            }
            <input asp-for="Logo" type="file" class="form-control">
            <span asp-validation-for="Logo" class="text-danger"></span>
            <input asp-for="ExistingLogo" type="hidden">

            @if (!string.IsNullOrEmpty(Model.ExistingImage))
            {
                <div class="mb-2">
                    <img src="~/images/@Model.ExistingImage" width="150" />
                </div>
            }
            <input asp-for="Image" type="file" class="form-control">
            <span asp-validation-for="Image" class="text-danger"></span>
            <input asp-for="ExistingImage" type="hidden">

            <input asp-for="Title" type="text" class="form-control" id="title" placeholder="Title">
            <span asp-validation-for="Title" class="text-danger"></span>

            <input asp-for="Description" type="text" class="form-control" id="description" placeholder="Description">
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary mr-2">Submit</button>
        <a asp-action="Index" class="btn btn-light">Cancel</a>
    </form>
</div>