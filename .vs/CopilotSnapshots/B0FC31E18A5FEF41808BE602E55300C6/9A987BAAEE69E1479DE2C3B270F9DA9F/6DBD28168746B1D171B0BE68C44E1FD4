@model NewsDetailVM

<main class="content">
    <div class="container-fluid p-0">
        <div class="row mb-2 mb-xl-3">
            <div class="col-auto d-none d-sm-flex">
                <h1 class="h3 d-line-height-1 mt-4">News Detail</h1>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-8 mx-auto">
                <div class="card shadow-sm">
                    <div class="card-header bg-light">
                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb mb-0">
                                <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">News</a></li>
                                <li class="breadcrumb-item active">Detail</li>
                            </ol>
                        </nav>
                    </div>

                    <div class="card-body p-4">
                        @if (!string.IsNullOrEmpty(Model.Image))
                        {
                            <div class="mb-4">
                                <img src="~/images/@Model.Image" alt="@Model.Question" class="img-fluid rounded-3" style="width: 100%; max-height: 450px; object-fit: cover; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
                            </div>
                        }

                        <div class="mb-4">
                            <h2 class="fw-bold text-dark mb-3" style="font-size: 1.8rem; line-height: 1.4;">@Model.Question</h2>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-6">
                                <div class="d-flex align-items-center p-3 bg-light rounded-2">
                                    <div class="flex-grow-1">
                                        <small class="text-muted d-block mb-1">Author</small>
                                        <span class="fw-semibold text-dark">@Model.Author</span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="d-flex align-items-center p-3 bg-light rounded-2">
                                    <div class="flex-grow-1">
                                        <small class="text-muted d-block mb-1">Publication Date</small>
                                        <span class="fw-semibold text-dark">@Model.Date</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <hr class="my-4">

                        <div class="mt-4">
                            <a asp-action="Index" class="btn btn-outline-secondary" role="button">
                                ← Back to List
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>
