
@model List<SettingVM>

<div class="container mt-5">
    <h1 class="text-center">Settings</h1>
    <table class="table mt-3">
        <thead>
            <tr>
                <th>Key</th>
                <th>Value</th>
                <th>Operation</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Key</td>
                    <td>
                        @if (item.Key.Equals("logo", StringComparison.OrdinalIgnoreCase))
                        {
                            <img src="~/images/@item.Value" alt="logo" style="width:60px; height:60px; object-fit:contain;" />
                        }
                        else
                        {
                            @item.Value
                        }
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning">Edit</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>