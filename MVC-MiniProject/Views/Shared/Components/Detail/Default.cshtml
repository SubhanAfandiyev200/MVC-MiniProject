@model CourseDetailUIVM

<div class="container py-5" style="margin-top: 180px">
    <div class="row g-4">
        <!-- Images -->
        <div class="col-md-6">
            <div class="position-relative mb-3">
                @if (Model.IsFeature)
                {
                    <span class="badge bg-warning text-dark position-absolute top-0 start-0 m-2">Featured</span>
                }
                else if (Model.IsNew)
                {
                    <span class="badge bg-success position-absolute top-0 start-0 m-2">New</span>
                }

                <img id="mainImage" src="~/images/@Model.Images.FirstOrDefault(m => m.IsMain).Name" class="img-fluid rounded shadow-sm" alt="@Model.Title">
            </div>

            <div class="row g-2">
                @foreach (var item in Model.Images)
                {
                    <div class="col-3">
                        <img src="~/images/@item.Name" class="img-fluid rounded border thumbnail-img" style="cursor:pointer;" alt="">
                    </div>
                }
            </div>
        </div>

        <!-- Details -->
        <div class="col-md-6">
            <h1 class="h3 fw-bold mb-2">@Model.Title</h1>
            <span class="h4 text-warning mb-3 d-block">$@Model.Price</span>

            <p class="text-muted mb-4">@Model.Description</p>

            <div class="d-flex align-items-center mb-4">
                <img src="~/images/@Model.TeacherImage" class="rounded-circle me-2" width="48" height="48" style="object-fit:cover;" alt="@Model.TeacherName">
                <div>
                    <div class="fw-semibold">@Model.TeacherName</div>
                    <small class="text-muted">@Model.SalesCount Sales</small>
                </div>
            </div>

            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary">
                Go Back
            </a>
        </div>
    </div>
</div>