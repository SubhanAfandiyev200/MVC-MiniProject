
@model IEnumerable<EventVM>
<div class="container mt-5">
    <h1 class="text-center">Events</h1>
    <a asp-action="Create" class="btn btn-success mt-5">Create</a>
    <table class="table mt-3">
        <thead>
            <tr>
                <th>Title</th>
                <th>Location</th>
                <th>Day</th>
                <th>Month</th>
                <th>Operations</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Title</td>
                    <td>@item.Location</td>
                    <td>@item.DateDay</td>
                    <td>@item.DateMonth</td>
                    <td>
                        <a asp-action="Detail" asp-route-id="@item.Id" class="btn btn-primary">Detail</a>
                        <a class="btn btn-danger delete-event" data-id="@item.Id">Delete</a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning">Edit</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
