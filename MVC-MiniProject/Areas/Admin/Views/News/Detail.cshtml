@model NewsDetailVM

<main class="content">
    <div class="container-fluid p-0">
        <div class="row mb-2 mb-xl-3">
            <div class="col-auto d-none d-sm-flex">
                <h1 class="h3 d-line-height-1 mt-4">News Detail</h1>
            </div>
        </div>

        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb mb-0">
                                <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">News</a></li>
                                <li class="breadcrumb-item active">Detail</li>
                            </ol>
                        </nav>
                    </div>

                    <div class="card-body">
                        @if (!string.IsNullOrEmpty(Model.Image))
                        {
                            <div class="row mb-4">
                                <div class="col-12">
                                    <img src="~/images/@Model.Image" alt="@Model.Question" class="img-fluid rounded" style="max-width: 100%; max-height: 400px; object-fit: cover;">
                                </div>
                            </div>
                        }

                        <div class="row mb-4">
                            <div class="col-12">
                                <h3 class="fw-bold text-dark mb-3">@Model.Question</h3>

                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <div class="d-flex align-items-center">
                                            <small class="text-muted me-2">Author:</small>
                                            <span class="fw-semibold">@Model.Author</span>
                                        </div>
                                        <div class="d-flex align-items-center">
                                            <small class="text-muted me-2">Author Id:</small>
                                            <span class="fw-semibold">@Model.AuthorId</span>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="d-flex align-items-center">
                                            <small class="text-muted me-2">Date:</small>
                                            <span class="fw-semibold">@Model.Date</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <hr class="my-4">

                        <div class="row mt-4">
                            <div class="col-12">
                                <a asp-action="Index" class="btn btn-outline-secondary" role="button">
                                    ← Back to List
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>
