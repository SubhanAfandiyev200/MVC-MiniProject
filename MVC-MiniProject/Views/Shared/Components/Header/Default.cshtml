@model HeaderVM
<header class="header">

    <div class="top_bar">
        <div class="top_bar_container">
            <div class="container">
                <div class="row">
                    <div class="col">
                        <div class="top_bar_content d-flex flex-row align-items-center justify-content-start">
                            <ul class="top_bar_contact_list">
                                <li><div class="question">Have any questions?</div></li>
                                <li>
                                    <div>@Model.Settings["HeaderNumber"]</div>
                                </li>
                                <li>
                                    <div><a href="~/https://preview.colorlib.com/cdn-cgi/l/email-protection" class="__cf_email__" data-cfemail="0960676f66496c65686c7b677d6c647965687d6c276a6664">@Model.Settings["Email"]</a></div>
                                </li>
                            </ul>
                            <div class="top_bar_login ml-auto">
                                @if (User.Identity.IsAuthenticated)
                                {
                                    <div class="header_top_login">
                                        <span class="welcome_text">Welcome, @Model.UserFullName</span>
                                        <span class="divider">/</span>
                                        <form asp-controller="Account" asp-action="LogOut" method="post" class="logout_form">
                                            <button type="submit" class="logout_btn">Log Out</button>
                                        </form>
                                    </div>
                                }
                                else
                                {
                                    <div class="header_top_login">
                                        <a asp-controller="Account" asp-action="Register">Register</a>
                                        <span class="divider">/</span>
                                        <a asp-controller="Account" asp-action="Login">Login</a>
                                    </div>
                                }

                                <style>
                                                                    .header_top_login {
                                                                        display: flex;
                                                                        align-items: center;
                                                                        gap: 10px;
                                                                    }

                                                                        .header_top_login a,
                                                                        .header_top_login .welcome_text {
                                                                            color: #ffffff;
                                                                            font-weight: 700;
                                                                            font-size: 13px;
                                                                            text-transform: uppercase;
                                                                            letter-spacing: 0.6px;
                                                                            text-decoration: none;
                                                                            transition: color 0.2s ease;
                                                                        }

                                                                            .header_top_login a:hover {
                                                                                color: #ff7a00;
                                                                            }

                                                                        .header_top_login .divider {
                                                                            color: #ffffff;
                                                                            opacity: 0.4;
                                                                            font-weight: 400;
                                                                        }

                                                                        .header_top_login .logout_btn {
                                                                            background: none;
                                                                            border: none;
                                                                            color: #ffffff;
                                                                            font-weight: 700;
                                                                            font-size: 13px;
                                                                            text-transform: uppercase;
                                                                            letter-spacing: 0.6px;
                                                                            cursor: pointer;
                                                                            padding: 0;
                                                                            font-family: inherit;
                                                                            transition: color 0.2s ease;
                                                                        }

                                                                            .header_top_login .logout_btn:hover {
                                                                                color: #ff7a00;
                                                                            }
                                </style>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="header_container">
        <div class="container">
            <div class="row">
                <div class="col">
                    <div class="header_content d-flex flex-row align-items-center justify-content-start">
                        <div class="logo_container">
                            <a href="~/#">
                                <div class="logo_content d-flex flex-row align-items-end justify-content-start">
                                    <div class="logo_img"><img src="~/images/@Model.Settings["Logo"]" alt=""></div>
                                    <div class="logo_text">@Model.Settings["LogoText"]</div>
                                </div>
                            </a>
                        </div>
                        <nav class="main_nav_contaner ml-auto">
                            <ul class="main_nav">
                                <li class="active"><a asp-controller="Home" asp-action="Index">home</a></li>
                                <li><a asp-controller="About" asp-action="Index">about us</a></li>
                                <li><a asp-controller="Course" asp-action="Index">courses</a></li>
                                <li><a href="~/news.html">news</a></li>
                                <li><a href="~/contact.html">contact</a></li>
                            </ul>
                            <div class="search_button"><i class="fa fa-search" aria-hidden="true"></i></div>

                            <div class="hamburger menu_mm">
                                <i class="fa fa-bars menu_mm" aria-hidden="true"></i>
                            </div>
                        </nav>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="header_search_container">
        <div class="container">
            <div class="row">
                <div class="col">
                    <div class="header_search_content d-flex flex-row align-items-center justify-content-end">
                        <form asp-controller="SearchCourse" asp-action="Index" method="get" class="header_search_form">
                            <input type="search" name="searchText" class="search_input" placeholder="Search" required="required">
                            <button type="submit" class="header_search_button d-flex flex-column align-items-center justify-content-center">
                                <i class="fa fa-search" aria-hidden="true"></i>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</header>