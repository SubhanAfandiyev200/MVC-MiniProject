
@model IEnumerable<AccountVM>


<div class="container mt-5">
    <h1 class="text-center">Users</h1>
    <table class="table mt-3">
        <thead>
            <tr>
                <th>FullName</th>
                <th>Email</th>
                <th>UserName</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.FullName</td>
                    <td>@item.Email</td>
                    <td>@item.UserName</td>
                </tr>
            }
        </tbody>
    </table>
</div>