@model AuthorDetailVM

<main class="content">
    <div class="container-fluid p-0">
        <div class="row mb-2 mb-xl-3">
            <div class="col-auto d-none d-sm-flex">
                <h1 class="h3 d-line-height-1 mt-4">Author Detail</h1>
            </div>
        </div>

        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb mb-0">
                                <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Authors</a></li>
                                <li class="breadcrumb-item active">Detail</li>
                            </ol>
                        </nav>
                    </div>

                    <div class="card-body">
                        <div class="row mb-4">
                            <div class="col-12">
                                <h3 class="fw-bold text-dark mb-1">@Model.Name</h3>
                                <p class="text-muted mb-0">
                                    <small>ID: @Model.Id</small>
                                </p>
                            </div>
                        </div>

                        <hr class="my-4">

                        <div class="row mt-4">
                            <div class="col-12">
                                <div class="d-grid gap-2 d-sm-flex">
                                    <a asp-action="Index" class="btn btn-outline-secondary" role="button">
                                        ← Back to List
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary" role="button">
                                        ✎ Edit
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger" role="button" onclick="return confirm('Are you sure you want to delete this author?')">
                                        🗑 Delete
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>
