@model IEnumerable<SearchCourseUIVM>


@if(Model.Count() == 0)
{
    <div class="alert alert-warning text-center" style="margin-top: 180px">
        No courses found
    </div>
}
else
{
    @foreach (var item in Model)
    {
        <div class="row featured_row">
            <div class="col-lg-6 featured_col">
                <div class="featured_content">
                    <div class="featured_header d-flex flex-row align-items-center justify-content-start">
                        @if (item.IsFeature)
                        {
                            <div class="course_tag"><a href="#">Featured</a></div>
                        }
                        else if (item.IsNew)
                        {
                            <div class="course_tag"><a href="#">New</a></div>
                        }
                        <div class="featured_price ml-auto">Price: <span>$@item.Price</span></div>
                    </div>
                    <div class="featured_title"><h3><a asp-controller="Detail" asp-action="Index" asp-route-id="@item.Id">@item.Title</a></h3></div>
                    <div class="featured_text">@item.Description</div>
                    <div class="featured_footer d-flex align-items-center justify-content-start">
                        <div class="featured_author_image"><img src="images/@item.TeacherImage" alt=""></div>
                        <div class="featured_author_name">By <a href="#">@item.TeacherName</a></div>
                        <div class="featured_sales ml-auto"><span>@item.SalesCount</span> Sales</div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6 featured_col">

                <div class="featured_background" style="background-image:url(images/@item.MainImage)"></div>
            </div>
        </div>
    }
}



